# okaru-pdf: compila la rama main del checkout (OKARU_PDF_REPO, por defecto ~/Projects/okaru-project/okaru-pdf).
pkgname=okaru-pdf
pkgver=1.0.1
pkgrel=1
pkgdesc='OKARU (郁): el visor de documentos'
arch=(x86_64)
url='https://github.com/MrAndyVF/okaru-pdf'
license=(MIT)
# Sin ABI estable: depende de la versión exacta del núcleo con el que se compiló (la instalada al compilar).
_core=$(pacman -Q okaru-core 2>/dev/null | cut -d' ' -f2)
depends=("okaru-core${_core:+=$_core}" poppler-glib)
makedepends=(meson ninja pkgconf okaru-core tomlplusplus nlohmann-json) # nlohmann-json: la piden las cabeceras del núcleo (okaru-core <= 1.2.4 no la declaraba)
optdepends+=('cups: imprimir / printing')
options=('!debug' '!lto')
source=("okaru-pdf::git+file://${OKARU_PDF_REPO:-$HOME/Projects/okaru-project/okaru-pdf}#branch=main")
sha256sums=(SKIP)

pkgver() {
  cd okaru-pdf
  git describe --long --tags --abbrev=9 --match 'v*' | sed 's/^v//; s/-\([0-9]*\)-g/.r\1.g/'
}

build() {
  arch-meson okaru-pdf build -Dtests=disabled
  meson compile -C build
}

# Ata el paquete a las bibliotecas del sistema con las que se compiló: si una actualización les cambia el soname,
# pacman se niega a hacerla hasta que se publique la app recompilada, en vez de dejarla sin abrir. Las que declaran
# su soname en provides las fija makepkg; las que no (libqalculate, taglib, libraw) se fijan a la versión
# mayor.menor de su paquete. glibc no cambia de soname y no se fija.
_fijar_bibliotecas() {
  local so dueno ver
  while read -r so; do
    if pacman -T "${so%%.so*}.so" >/dev/null; then
      depends+=("${so%%.so*}.so")
    elif dueno=$(pacman -Qqo "/usr/lib/$so" 2>/dev/null) && [[ $dueno != glibc ]]; then
      ver=$(pacman -Q "$dueno" | cut -d' ' -f2)
      ver=${ver#*:}
      ver=${ver%-*}
      if [[ $ver =~ ^([0-9]+)\.([0-9]+) ]]; then
        depends+=("$dueno>=${BASH_REMATCH[0]}" "$dueno<${BASH_REMATCH[1]}.$((BASH_REMATCH[2] + 1))")
      else
        depends+=("$dueno=$ver")
      fi
    fi
  done < <(find "$pkgdir" -type f -perm -u+x -exec readelf -d {} + 2>/dev/null \
    | sed -nr 's/.*Shared library: \[(.*)\].*/\1/p' | sort -u)
}

package() {
  meson install -C build --destdir "$pkgdir"
  install -Dm644 okaru-pdf/LICENSE -t "$pkgdir/usr/share/licenses/$pkgname"
  _fijar_bibliotecas
}
